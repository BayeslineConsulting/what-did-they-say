{
 "cleanUrls": true,
 "trailingSlash": true,
 "rewrites": [
  {
   "source": "/",
   "destination": "/2026-10/"
  }
 ],
 "redirects": [
  {
   "source": "/2026-10/list/",
   "destination": "/2026-10/plan/",
   "permanent": true
  }
 ],
 "headers": [
  {
   "source": "/assets/(.*)",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=3600, stale-while-revalidate=86400"
    }
   ]
  },
  {
   "source": "/(.*)",
   "headers": [
    {
     "key": "X-Content-Type-Options",
     "value": "nosniff"
    },
    {
     "key": "Referrer-Policy",
     "value": "strict-origin-when-cross-origin"
    },
    {
     "key": "X-Frame-Options",
     "value": "SAMEORIGIN"
    }
   ]
  }
 ]
}